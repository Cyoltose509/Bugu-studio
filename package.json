{
  "name": "bugoostudio-site",
  "version": "0.2.6",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo -p 1145",
    "build": "prisma generate && next build",
    "start": "next start -p 1145",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:push": "tsx scripts/safe-db-push.ts",
    "db:push:accept": "tsx scripts/safe-db-push.ts --accept-data-loss",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:compat": "playwright test e2e/compatibility.spec.ts",
    "test:all": "node -e \"console.log('\\n🔬 单元测试...');\" && vitest run && node -e \"console.log('\\n🌐 E2E 测试...');\" && playwright test && node -e \"console.log('\\n✅ 全部测试完成');\"",
    "test:perf": "vitest run --config vitest.config.ts __tests__/performance/",
    "test:security": "vitest run --config vitest.config.ts __tests__/api/security*",
    "test:ui": "vitest run --config vitest.config.ts __tests__/ui/",
    "test:integration": "vitest run --config vitest.config.ts __tests__/integration/",
    "test:regression": "vitest run --config vitest.config.ts __tests__/regression/",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:load": "tsx scripts/benchmark.ts --mode load",
    "benchmark:stress": "tsx scripts/benchmark.ts --mode stress",
    "benchmark:spike": "tsx scripts/benchmark.ts --mode spike",
    "test:csp-real": "tsx scripts/test-csp-real.ts",
    "test:error-real": "tsx scripts/test-error-real.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "15.1.11",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "react-email": "^6.5.0",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "happy-dom": "^20.10.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
