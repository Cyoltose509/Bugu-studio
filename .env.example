# 复制为 .env.local 后填写。不要提交真实密钥。

# 数据库（Supabase）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js
AUTH_SECRET="生成一段足够长的随机字符串"
AUTH_URL="http://localhost:3000"
# 可选 OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# 站点
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2（上传 + 云端备份必需）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 邮件（Resend）
RESEND_API_KEY=
MAIL_FROM="布谷工作室 <noreply@example.com>"

# 可选：监控页自动填充（正式密码在数据库 siteSetting，不依赖此项）
# MONITORING_PASSWORD=

# 可选：备份专用加密密钥（64 位 hex 或任意口令）。未设置则用 AUTH_SECRET 派生。
# 生产建议单独配置，避免以后轮换 AUTH_SECRET 导致旧备份无法解密。
# BACKUP_ENCRYPTION_KEY=
