# 环境变量模板 - 复制为 .env.local 并填入真实值
# 不要将 .env.local 提交到 Git

# ============================
# 数据库
# ============================
DATABASE_URL="postgresql://gameclub:your_password@localhost:5432/gameclub_db?schema=public"

# ============================
# Auth.js
# ============================
# 生成方法: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-minimum-32-chars"
AUTH_URL="http://localhost:3000"

# ============================
# Cloudflare R2 存储
# ============================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="gameclub-assets"
R2_PUBLIC_URL="https://your-custom-domain.com"

# ============================
# 邮件服务 (SMTP)
# ============================
SMTP_HOST="smtp.qq.com"
SMTP_PORT="587"
SMTP_USER="your@qq.com"
SMTP_PASS="your_smtp_auth_code"
SMTP_FROM="大学游戏开发社团 <noreply@yourclub.com>"

# ============================
# 应用配置
# ============================
NEXT_PUBLIC_SITE_URL="https://yourclub.com"
NEXT_PUBLIC_SITE_NAME="游戏开发社团"
NEXT_PUBLIC_CLUB_FOUNDED_YEAR="2018"

# ============================
# 速率限制（可选，默认使用内存）
# ============================
# REDIS_URL="redis://localhost:6379"
