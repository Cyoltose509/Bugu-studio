# 环境变量模板 - 复制为 .env.local 并填入真实值
# 不要将 .env.local 提交到 Git
# 生产部署：复制为 .env（docker-compose 读取）

# ============================
# 数据库 - Supabase
# ============================
# DATABASE_URL: 应用运行时使用（PgBouncer 事务池，需加 pgbouncer=true）
DATABASE_URL="postgresql://postgres.{PROJECT_REF}:{PASSWORD}@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
# DIRECT_URL: Prisma 迁移/生成客户端用（直连或会话池）
DIRECT_URL="postgresql://postgres:{PASSWORD}@db.{PROJECT_REF}.supabase.co:5432/postgres"

# ============================
# Auth.js v5
# ============================
# 生成方法: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-minimum-32-chars"
AUTH_URL="https://yourclub.com"

# ============================
# Cloudflare R2 存储（可选，正式上线用）
# ============================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="bugu-assets"
R2_PUBLIC_URL="https://your-custom-domain.com"

# ============================
# 邮件服务（Resend 或 SMTP）
# ============================
RESEND_API_KEY="re_xxxxxxxxxxxxxx"
MAIL_FROM="布谷工作室 <noreply@yourclub.com>"

# SMTP 方式（二选一）:
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="587"
# SMTP_USER="your@qq.com"
# SMTP_PASS="your_smtp_auth_code"
# SMTP_FROM="大学游戏开发社团 <noreply@yourclub.com>"

# ============================
# 应用配置
# ============================
NEXT_PUBLIC_SITE_URL="https://yourclub.com"
NEXT_PUBLIC_SITE_NAME="布谷工作室"
NEXT_PUBLIC_CLUB_FOUNDED_YEAR="2018"

# ============================
# 速率限制（可选，默认使用内存）
# ============================
# REDIS_URL="redis://localhost:6379"
