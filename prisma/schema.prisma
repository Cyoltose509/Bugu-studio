// ============================================================
// Prisma Schema - 布谷工作室
// 版本: 1.0.0
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets  = ["native", "linux-musl-openssl-3.0.x", "darwin-arm64", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 枚举类型
// ============================================================

enum UserRole {
  GUEST    // 游客（未注册，概念性）
  USER     // 注册用户
  MEMBER   // 社团成员（需管理员审批）
  REVIEWER // 审核员
  ADMIN    // 管理员
}

enum ProjectStatus {
  DRAFT     // 草稿（作者编辑中）
  PENDING   // 待审核
  PUBLISHED // 已发布（公开）
  REJECTED  // 审核失败
  ARCHIVED  // 已归档
}

enum ProjectType {
  DEMO  // Demo 演示
  STEAM // Steam 发布
  ITCH  // itch.io 发布
  OTHER // 其他
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  USER_LOGOUT
  USER_ROLE_CHANGE
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_SUBMIT
  PROJECT_APPROVE
  PROJECT_REJECT
  FILE_UPLOAD
  FILE_DELETE
  ADMIN_ACTION
  RATE_LIMIT_HIT
  SUSPICIOUS_REQUEST
}

enum AnnouncementType {
  INFO    // 普通通知
  SUCCESS // 成功通知
  WARNING // 警告通知
  DANGER  // 危险通知
}

// ============================================================
// 用户 & 认证
// ============================================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  emailVerified    DateTime?
  name             String?
  bio              String?  @db.Text // 个人介绍（所有用户可编辑）
  passwordHash     String?  // scrypt hash
  image            String?  // 头像 URL（R2）
  avatarChangedAt  DateTime? // 上次更换头像时间（限制7天一次）
  nameChangedAt    DateTime? // 上次修改名称时间（限制7天一次）
  role             UserRole @default(USER)
  isActive         Boolean  @default(true)
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  member        ClubMember?
  submittedProjects Project[] @relation("ProjectSubmitter")
  reviewedProjects  Review[]
  auditLogs     AuditLog[] @relation("AuditUser")
  loginAttempts LoginAttempt[]
  sessions      Session[]
  accounts      Account[]
  comments      Comment[]
  notifications Notification[]
  projectLikes  ProjectLike[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

// Auth.js 所需表
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier   String
  token        String   @unique
  expires      DateTime
  name         String?  @db.Text    // 待验证注册：昵称
  passwordHash String?  @db.Text    // 待验证注册：密码哈希
  role         String?  @db.VarChar(20) // 待验证注册：角色

  @@unique([identifier, token])
}

// 邀请码（注册时赋予对应角色）
model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique           // 如 "BUGU-MEMBER-ABC123"
  role        UserRole @default(MEMBER)  // 注册后赋予的角色
  maxUses     Int?                      // null = 无限次
  usedCount   Int      @default(0)
  expiresAt   DateTime?                 // null = 永不过期
  description String?                   // 备注（谁发的，用途等）
  isActive    Boolean  @default(true)
  createdBy   String?                   // 创建者 userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

// 登录失败记录（防暴力破解）
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ============================================================
// 社团成员
// ============================================================

model ClubMember {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String                    // 展示名
  avatar      String?                   // 头像 URL（R2）
  bio         String?  @db.Text
  grade       String?                   // 年级，如 "2021级"
  cohortYear  Int?                      // 第几届（入学年份届别），取代 joinYear 的语义
  joinYear    Int?                      // 入社年份（保留兼容，新数据不再使用）
  graduateYear Int?                     // 毕业年份（null = 在读）
  skills      String[] @default([])     // 职能标签
  isActive    Boolean  @default(true)   // 是否在读/活跃
  sortOrder   Int      @default(0)
  position    String   @default("MEMBER") // MEMBER | PRESIDENT | VICE_PRESIDENT
  location    String?                   // 所在地（省份/国家）
  phone       String?                   // 电话（敏感项，仅成员+可见）
  wechat      String?                   // 微信（敏感项，仅成员+可见）
  qq          String?                   // QQ（敏感项，仅成员+可见）
  notifyNewProjects Boolean @default(false) // 关注作品上新通知
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMembers  ProjectMember[]
  socialLinks     MemberLink[]

  @@index([joinYear])
  @@index([isActive])
}

// 成员自定义链接（可自由添加多个）
model MemberLink {
  id        String   @id @default(cuid())
  memberId  String
  label     String   // 显示标签，如 "GitHub", "B站", "个人网站"
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ============================================================
// 作品 & 项目
// ============================================================

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique  // URL 友好标识符
  title        String
  subtitle     String?
  description  String        @db.Text
  coverImage   String?                // 封面图 URL（R2）
  status       ProjectStatus @default(DRAFT)
  type         ProjectType
  developYear  Int                    // 开发年份
  publishedAt  DateTime?              // 实际发布时间

  // 外部链接
  steamUrl      String?
  githubUrl     String?
  itchUrl       String?
  panUrl        String?    // 百度网盘
  driveUrl      String?    // Google Drive
  onedriveUrl   String?
  videoUrl      String?    // 演示视频
  websiteUrl    String?    // 作品官网

  // 内容
  devlog       String?  @db.Text  // 开发日志（Markdown）
  techStack    String[] @default([])
  isFeatured   Boolean  @default(false)   // 精选作品

  // 提交信息
  submitterId  String
  submittedAt  DateTime?
  reviewNote   String?  @db.Text  // 审核意见

  // 统计（非实时，定期更新）
  viewCount    Int @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  submitter    User @relation("ProjectSubmitter", fields: [submitterId], references: [id])
  images       ProjectImage[]
  links        ProjectLink[]
  members      ProjectMember[]
  tags         ProjectTag[]
  reviews      Review[]
  comments     Comment[]
  likes        ProjectLike[]

  @@index([status])
  @@index([type])
  @@index([developYear])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([slug])
}

// 作品截图
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String               // R2 URL
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// 作品-成员多对多（含角色）
model ProjectMember {
  id           String  @id @default(cuid())
  projectId    String
  memberId     String? // 社团成员 ID（可选，外部成员为 null）
  externalName String? // 非社团成员姓名
  role         String   // 如 "主程序员", "美术", "策划", "音效"
  sortOrder    Int     @default(0)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  ClubMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
}

// 作品外部链接（动态添加，如 Steam、itch.io、官网、网盘等）
model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  label     String            // 显示标签，如 "Steam", "itch.io", "官网", "百度网盘"
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================================
// 标签系统
// ============================================================

model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  color       String  @default("#6366f1") // 十六进制颜色
  description String?
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())

  projects ProjectTag[]

  @@index([slug])
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}

// ============================================================
// 审核系统
// ============================================================

model Review {
  id         String   @id @default(cuid())
  projectId  String
  reviewerId String
  approved   Boolean
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@index([projectId])
  @@index([reviewerId])
}

// ============================================================
// 公告系统
// ============================================================

model Announcement {
  id        String           @id @default(cuid())
  title     String
  content   String           @db.Text
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive, createdAt])
}

// ============================================================
// 历史档案
// ============================================================

// 每年的社团活动/大事记
model YearEvent {
  id          String   @id @default(cuid())
  year        Int
  title       String
  body        String?  @db.Text           // 正文内容
  eventDate   DateTime?                   // 事件日期
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images EventImage[]                     // 最多5张图片

  @@index([year])
}

model EventImage {
  id       String    @id @default(cuid())
  eventId  String
  url      String
  altText  String?
  sortOrder Int      @default(0)

  event YearEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ============================================================
// 系统配置
// ============================================================

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
}

// 速率限制（防滥用）
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique  // 如 "email:user@test.com" 或 "avatar:userId"
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([key])
}

// ============================================================
// 审计日志
// ============================================================

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  targetType String?    // 目标资源类型，如 "Project", "User"
  targetId   String?    // 目标资源 ID
  metadata   Json?      // 额外上下文信息
  ipAddress  String?
  userAgent  String?
  statusCode Int?
  createdAt  DateTime   @default(now())

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// 留言 & 通知系统
// ============================================================

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(300)
  projectId String
  userId    String
  parentId  String?  // 回复的目标留言（null = 顶层留言）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[]     @relation("CommentReplies")

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// ── 作品点赞（爱心）──
model ProjectLike {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "PROJECT_REVIEW" | "COMMENT_REPLY" | "COMMENT_LIKE" | "ROLE_CHANGE" | "NEW_PROJECT" | "NEW_USER"
  title       String
  content     String
  relatedId   String?  // projectId / commentId / userId
  relatedType String?  // "Project" | "Comment" | "User"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}
