// ============================================================
// Prisma Schema - 布谷工作室
// 版本: 1.0.0
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "darwin-arm64", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 枚举类型
// ============================================================

enum UserRole {
  GUEST // 游客（未注册，概念性）
  USER // 注册用户
  MEMBER // 社团成员（需管理员审批）
  ADMIN // 管理员
}

enum ProjectStatus {
  DRAFT // 草稿（作者编辑中）
  PENDING // 待审核
  PUBLISHED // 已发布（公开）
  REJECTED // 审核失败
  ARCHIVED // 已归档
}

enum ProjectType {
  IN_DEVELOPMENT   // 开发阶段
  TRIAL_DEMO       // 提供试玩
  MINI_GAME        // 小游戏
  OFFICIAL_RELEASE // 正式上架
  // 以下为旧值，保留向下兼容，不再使用
  DEMO
  STEAM
  ITCH
  OTHER
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  USER_LOGOUT
  USER_ROLE_CHANGE
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_SUBMIT
  PROJECT_APPROVE
  PROJECT_REJECT
  FILE_UPLOAD
  FILE_DELETE
  ADMIN_ACTION
  RATE_LIMIT_HIT
  SUSPICIOUS_REQUEST
  CREATE
  UPDATE
  DELETE
  OTHER
}

enum ActivityType {
  MEETING // 例会
  COURSE // 公开课
  COMPETITION // Game Jam 等比赛
  GENERAL // 普通社团活动
}

enum ActivityStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布
  ARCHIVED // 已归档
}

enum ProposalType {
  SHARE // 分享申请
  SHOWCASE // 展示申请
}

enum ProposalStatus {
  PENDING // 待审核
  APPROVED // 已通过
  REJECTED // 已拒绝
}

// ============================================================
// 用户 & 认证
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  bio             String?   @db.Text // 个人介绍（所有用户可编辑）
  passwordHash    String? // scrypt hash
  image           String? // 头像 URL（R2）
  avatarChangedAt DateTime? // 上次更换头像时间（限制7天一次）
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  confirmedNotMember Boolean @default(false) // 管理员标记：确认为非社团成员
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  member                 ClubMember?
  submittedProjects      Project[]               @relation("ProjectSubmitter")
  projectMembers         ProjectMember[]         // 作为非社团成员参与的作品
  reviewedProjects       Review[]
  auditLogs              AuditLog[]              @relation("AuditUser")
  loginAttempts          LoginAttempt[]
  sessions               Session[]
  accounts               Account[]
  comments               Comment[]
  notifications          Notification[]
  errorReports           ErrorReport[]
  projectLikes           ProjectLike[]
  meetingProposals       MeetingProposal[]
  meetingTalks           MeetingTalk[]

  // Game Jam
  jamLedTeams           JamTeam[]
  jamTeamMembers        JamTeamMember[]
  jamTeamApplications   JamTeamApplication[]
  sentInvitations       JamTeamInvitation[]  @relation("JamTeamInviter")
  receivedInvitations   JamTeamInvitation[]  @relation("JamTeamInvitee")
  jamJudges             JamJudge[]
  jamScores             JamScore[]
  courseScores          CourseScore[]   @relation("CourseScoreJudge")

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

// Auth.js 所需表
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier   String
  token        String   @unique
  expires      DateTime
  name         String?  @db.Text // 待验证注册：昵称
  passwordHash String?  @db.Text // 待验证注册：密码哈希
  role         String?  @db.VarChar(20) // 待验证注册：角色

  @@unique([identifier, token])
}

// 密码重置令牌
model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String   // 用户邮箱
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([expires])
}

// 邀请码（注册时赋予对应角色）
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique // 如 "BUGOO-MEMBER-ABC123"
  role        UserRole  @default(MEMBER) // 注册后赋予的角色
  maxUses     Int? // null = 无限次
  usedCount   Int       @default(0)
  expiresAt   DateTime? // null = 永不过期
  description String? // 备注（谁发的，用途等）
  isActive    Boolean   @default(true)
  createdBy   String? // 创建者 userId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// 登录失败记录（防暴力破解）
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ============================================================
// 社团成员
// ============================================================

model ClubMember {
  id                String   @id @default(cuid())
  userId            String   @unique
  displayName       String // 展示名
  avatar            String? // 头像 URL（R2）
  bio               String?  @db.Text
  grade             Int? // 年级（入学年份，如2021=2021级）
  joinYear          Int? // 入社年份
  realName          String? // 真名（敏感信息，仅成员可见）
  college           String? // 就读学院（敏感信息，仅成员可见，未毕业时填写）
  major             String? // 专业（敏感信息，仅成员可见，未毕业时填写）
  workLocation      String? // 工作所在地（敏感信息，仅成员可见，已毕业时填写）
  workPosition      String? // 工作岗位（敏感信息，仅成员可见，已毕业时填写）
  graduated         Boolean  @default(false) // 是否已毕业
  skills            String[] @default([]) // 职能标签
  sortOrder         Int      @default(0)
  position          String   @default("MEMBER") // MEMBER | PRESIDENT | VICE_PRESIDENT | PAST_PRESIDENT | PAST_VICE_PRESIDENT | FOUNDER | NON_STUDENT
  location          String? // 所在地（省份/国家）
  phone             String? // 电话（敏感项，仅成员+可见）
  wechat            String? // 微信（敏感项，仅成员+可见）
  qq                String? // QQ（敏感项，仅成员+可见）
  notifyNewProjects Boolean  @default(false) // 关注作品上新通知
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]
  socialLinks    MemberLink[]
  workExperiences WorkExperience[]

  @@index([joinYear])
}

// 成员自定义链接（可自由添加多个）
model MemberLink {
  id        String   @id @default(cuid())
  memberId  String
  label     String // 显示标签，如 "GitHub", "B站", "个人网站"
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// 工作经历（仅成员可见）
model WorkExperience {
  id        String    @id @default(cuid())
  memberId  String
  type      String    @default("工作") // "工作" 或 "学习"
  company   String // 公司/学校 名称
  position  String // 职位/专业
  startDate DateTime // 入职/入学时间
  endDate   DateTime? // 离职/毕业时间（null=至今）
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([memberId, sortOrder])
}

// ============================================================
// CSP 违规报告
// ============================================================

model CspReport {
  id                String   @id @default(cuid())
  blockedUri        String?  @db.Text // 被拦截的资源 URI
  violatedDirective String   // 被违反的 CSP 指令，如 "script-src"
  documentUri       String?  @db.Text // 发生违规的页面 URI
  referrer          String?  @db.Text // 来源页面
  sourceFile        String?  @db.Text // 源码文件（如内联脚本有 source-file）
  lineNumber        Int?     // 行号
  columnNumber      Int?     // 列号
  originalPolicy    String?  @db.Text // 触发违规的 CSP 策略（截断至500字符）
  disposition       String?  // "enforce" | "report" — 策略是强制执行还是仅报告
  sample            String?  @db.Text // 违规代码前40个字符
  scriptSample      String?  @db.Text // 内联脚本样本
  userAgent         String?  // 浏览器 UA
  ipAddress         String?  // 客户端 IP
  count             Int      @default(1) // 相同违规聚合计数（用于去重显示）
  lastSeenAt        DateTime @default(now())
  firstSeenAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([violatedDirective, lastSeenAt])
  @@index([documentUri, lastSeenAt])
  @@index([lastSeenAt])
  @@index([blockedUri])
}

// ── 前端错误报告（用户遇到错误时自动上报）──
model ErrorReport {
  id         String   @id @default(cuid())
  reportId   Int      @unique // 展示用递增编号，从 1 起
  message    String   @db.Text
  stack      String?  @db.Text
  url        String?  @db.Text // 发生错误的页面 URL
  userId     String?  // 登录用户（可选，未登录也能上报）
  userAgent  String?
  status     String   @default("UNREAD") // UNREAD | READ | RESOLVED
  count      Int      @default(1) // 相同错误聚合计数
  lastSeenAt DateTime @default(now())
  firstSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([status])
  @@index([createdAt])
  @@index([url])
}

// ============================================================
// 作品 & 项目
// ============================================================

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique // URL 友好标识符
  title       String
  subtitle    String?
  description String        @db.Text
  coverImage  String? // 封面图 URL（R2）
  status      ProjectStatus @default(DRAFT)
  type        ProjectType
  developYear Int // 开发年份
  publishedAt DateTime? // 实际发布时间

  // 内容
  techStack  String[] @default([])
  aiUsages   String[] @default([]) // AI 使用声明: AI_GENERATED, AI_ART, AI_MUSIC
  platforms  String[] @default([]) // 支持平台: WINDOWS, MAC, LINUX, ANDROID, IOS, WEB
  awards     String[] @default([]) // 所获奖项


  // 提交信息
  submitterId String
  submittedAt DateTime?
  reviewNote  String?   @db.Text // 审核意见

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  submitter              User                    @relation("ProjectSubmitter", fields: [submitterId], references: [id])
  images                 ProjectImage[]
  links                  ProjectLink[]
  members                ProjectMember[]
  tags                   ProjectTag[]
  reviews                Review[]
  comments               Comment[]
  likes                  ProjectLike[]
  jamSubmissions         JamSubmission[]

  @@index([status])
  @@index([type])
  @@index([developYear])

  @@index([createdAt])
  @@index([slug])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([status, type, publishedAt])
}

// 作品截图
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String // R2 URL
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// 作品-成员多对多（含角色）
model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  memberId     String? // 社团成员 ID（可选，外部成员为 null）
  userId       String? // 非社团成员的注册用户 ID
  externalName String? // 非社团成员/非注册用户姓名
  roles        String[] // 如 ["程序", "美术", "策划"]
  sortOrder    Int      @default(0)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  ClubMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@index([userId])
}

// 作品外部链接（动态添加，如 Steam、itch.io、官网、网盘等）
model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  label     String // 显示标签，如 "Steam", "itch.io", "官网", "百度网盘"
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================================
// 标签系统
// ============================================================

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1") // 十六进制颜色
  group       String? // 分组：引擎、大类、要素 等，null = 未分组
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  projects ProjectTag[]

  @@index([slug])
  @@index([group])
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}

// ============================================================
// 审核系统
// ============================================================

model Review {
  id         String   @id @default(cuid())
  projectId  String
  reviewerId String
  approved   Boolean
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@index([projectId])
  @@index([reviewerId])
}

// ============================================================
// 历史档案
// ============================================================

// 每年的社团活动/大事记
model YearEvent {
  id        String    @id @default(cuid())
  year      Int
  title     String
  body      String?   @db.Text // 正文内容
  eventDate    DateTime? // 事件起始日期
  eventEndDate DateTime? // 事件结束日期（为空则仅显示起始日期）
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  images EventImage[] // 最多5张图片

  @@index([year])
}

model EventImage {
  id        String  @id @default(cuid())
  eventId   String
  url       String
  altText   String?
  sortOrder Int     @default(0)

  event YearEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ============================================================
// 系统配置
// ============================================================

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
}

// 速率限制（防滥用）
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // 如 "email:user@test.com" 或 "avatar:userId"
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([key])
}

// ============================================================
// 审计日志
// ============================================================

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  targetType String? // 目标资源类型，如 "Project", "User"
  targetId   String? // 目标资源 ID
  beforeData Json? // 变更前数据快照（DELETE/UPDATE 时捕获）
  afterData  Json? // 变更后数据快照（CREATE/UPDATE 时捕获）
  metadata   Json? // 额外上下文信息
  ipAddress  String?
  userAgent  String?
  statusCode Int?
  createdAt  DateTime    @default(now())

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// 大版本备份记录
model BackupVersion {
  id          String   @id @default(cuid())
  version     Int      @unique // 自增版本号 1, 2, 3...
  label       String? // 备注/标签
  recordCount Int      @default(0)
  fileSize    Int? // 备份文件大小 (bytes)
  status      String   @default("completed") // completed | failed
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// 留言 & 通知系统
// ============================================================

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(300)
  projectId String
  userId    String
  parentId  String? // 回复的目标留言（null = 顶层留言）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([parentId, createdAt])
}

// ── 作品点赞（爱心）──
model ProjectLike {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String // "PROJECT_REVIEW" | "COMMENT_REPLY" | "COMMENT_LIKE" | "ROLE_CHANGE" | "NEW_PROJECT" | "NEW_USER"
  title       String
  content     String
  relatedId   String? // projectId / commentId / userId
  relatedType String? // "Project" | "Comment" | "User"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ============================================================
// 活动系统 (Activity System)
// ============================================================

model Activity {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  summary          String?
  description      String?        @db.Text
  type             ActivityType   @default(GENERAL)
  location         String?
  meetingUrl       String?                      // 线上链接（腾讯会议等）
  startTime        DateTime
  endTime          DateTime
  coverImage       String? // R2 URL
  registrationOpen Boolean        @default(false)
  maxParticipants  Int?
  theme            String?        @db.Text // Game Jam — 比赛题目
  themeRevealedAt  DateTime?               // Game Jam — 题目公布时间
  maxTeamSize      Int?          @default(6) // Game Jam — 每队最大人数
  status           ActivityStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  proposals   MeetingProposal[]
  talks       MeetingTalk[]

  // Game Jam
  jamTeams       JamTeam[]
  jamJudges      JamJudge[]
  jamSubmissions JamSubmission[]
  courseScores   CourseScore[] @relation("CourseScoreActivity")

  @@index([status])
  @@index([type])
  @@index([startTime])
  @@index([endTime])
  @@index([status, startTime])
  @@index([status, endTime])
}

// 例会 — 结构化分享条目（主讲 + 标题 + BV）
// speaker 为展示名；userId 可选，关联站内用户后前台可链到成员页/个人中心
model MeetingTalk {
  id         String   @id @default(cuid())
  activityId String
  speaker    String
  userId     String? // 可选：关联 User；有 ClubMember 时前台链 /members/[id]
  title      String
  bvId       String? // 如 BV1xxxxxxxx，可选（剪辑发布后补录）
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([activityId, sortOrder])
  @@index([userId])
}

// 例会 — 分享/展示申请
model MeetingProposal {
  id           String         @id @default(cuid())
  activityId   String
  userId       String
  title        String
  description  String?        @db.Text
  proposalType ProposalType   @default(SHARE)
  status       ProposalStatus @default(PENDING)
  adminNote    String?        @db.Text // 审核意见
  createdAt    DateTime       @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
  @@index([status])
}

// ============================================================
// Game Jam 系统 (Game Jam System)
// ============================================================

// Game Jam — 参赛队伍
model JamTeam {
  id         String   @id @default(cuid())
  activityId String
  name       String
  leaderId   String   // 队长 userId
  topic      String?  // 公开课讲题 (仅 COURSE 类型使用)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity     Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  leader       User                @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  members      JamTeamMember[]
  applications JamTeamApplication[]
  invitations  JamTeamInvitation[]
  submission   JamSubmission?
  courseScores CourseScore[] @relation("CourseScoreTeam")

  @@unique([activityId, name])
  @@index([activityId])
  @@index([leaderId])
}

// Game Jam — 队伍成员
model JamTeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("MEMBER") // LEADER | MEMBER
  joinedAt DateTime @default(now())

  team JamTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// Game Jam — 入队申请
model JamTeamApplication {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  message   String?  @db.Text
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())

  team JamTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
}

// Game Jam — 入队邀请
model JamTeamInvitation {
  id        String   @id @default(cuid())
  teamId    String
  inviterId String
  inviteeId String
  message   String?  @db.Text
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  team    JamTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User    @relation("JamTeamInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User    @relation("JamTeamInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([teamId, inviteeId])
  @@index([teamId])
  @@index([inviteeId])
  @@index([status])
}

// Game Jam — 作品提交
model JamSubmission {
  id          String   @id @default(cuid())
  activityId  String
  teamId      String   @unique // 每队只允许一个提交
  projectId   String?  // 关联作品
  title       String
  description String?  @db.Text
  files       String[] @default([]) // 截图/玩法 GIF 等文件 URL
  metadata    Json?    // 扩展数据：{ coverImage?, links?, creators?, tagIds?, customTags? }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  team     JamTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scores   JamScore[]

  @@index([activityId])
}

// Game Jam — 评委
model JamJudge {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
}

// Game Jam — 评分
model JamScore {
  id           String  @id @default(cuid())
  submissionId String
  judgeId      String
  // 评分维度: { "creativity": 85, "execution": 90, "theme": 80, "overall": 88 }
  criteria     Json    @default("{}")
  totalScore   Int
  comment      String? @db.Text
  createdAt    DateTime @default(now())

  submission JamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge      User          @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
  @@index([submissionId])
  @@index([judgeId])
}

// 公开课讲题评分 (COURSE 类型活动)
model CourseScore {
  id         String   @id @default(cuid())
  teamId     String
  judgeId    String
  activityId String
  // 评分维度: { "content": 85, "delivery": 80, "preparation": 90 }
  criteria   Json     @default("{}")
  totalScore Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  team     JamTeam  @relation("CourseScoreTeam", fields: [teamId], references: [id], onDelete: Cascade)
  judge    User     @relation("CourseScoreJudge", fields: [judgeId], references: [id], onDelete: Cascade)
  activity Activity @relation("CourseScoreActivity", fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([teamId, judgeId])
  @@index([teamId])
  @@index([judgeId])
  @@index([activityId])
}
